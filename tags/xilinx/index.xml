&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#756d59"&gt; 5&lt;/span&gt;&lt;span&gt;add_files &lt;span style="color:#fe8019"&gt;-&lt;/span&gt;fileset sources_1 .&lt;span style="color:#fe8019"&gt;/&lt;/span&gt;src&lt;span style="color:#fe8019"&gt;/&lt;/span&gt;design&lt;span style="color:#fe8019"&gt;/&lt;/span&gt;
