&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#756d59"&gt;12&lt;/span&gt;&lt;span&gt;create_run &lt;span style="color:#fe8019"&gt;-&lt;/span&gt;flow &lt;span style="color:#fe8019"&gt;{&lt;/span&gt;Vivado Synthesis &lt;span style="color:#d3869b"&gt;2022&lt;/span&gt;&lt;span style="color:#fe8019"&gt;}&lt;/span&gt; synth_1
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#756d59"&gt;13&lt;/span&gt;&lt;span&gt;set_property strategy &lt;span style="color:#b8bb26"&gt;&amp;#34;Flow_PerfOptimized_high&amp;#34;&lt;/span&gt; &lt;span style="color:#fe8019"&gt;[&lt;/span&gt;get_runs synth_1&lt;span style="color:#fe8019"&gt;]&lt;/span&gt;
